# Hoard settings. Copy to .env (gitignored) and fill in what you need; every value is optional.
# ops/deploy.sh and ops/run.sh source .env, and Vite reads the VITE_* values at build time.

# --- Deploy (ops/deploy.sh, run on your Mac) ---
# The ssh host the server runs on.
HOARD_DEPLOY_HOST=my-server

# --- Web client (read by Vite at build time) ---
# What the UI calls the server ("On <name>", "Can't reach <name>"). Default: "the server".
VITE_SERVER_NAME="the server"

# --- Server ---
# Port the server listens on (127.0.0.1 only). Default: 8781. ops/run.sh always uses 8781.
PORT=8781
# Where the SQLite store and its daily backups live. Default: ~/Library/Application Support/Hoard.
HOARD_DATA=
# OMDb API key (https://www.omdbapi.com/apikey.aspx). Leave empty and movies and shows get no details or posters.
OMDB_API_KEY=
# Jellyfin server URL (e.g. http://127.0.0.1:8096) and an API key from its dashboard.
# Leave empty and "On the server" and auto-marking played titles are off.
JELLYFIN_URL=
JELLYFIN_API_KEY=

# --- Suggestions (headless Claude Code) ---
# Who suggestions are for, by name in Claude's prompt. Default: "someone".
HOARD_USER_NAME=someone
# Model passed to `claude -p --model`. Default: opus.
HOARD_CLAUDE_MODEL=opus
# Path to the claude CLI. Default: the newest copy the Claude desktop app keeps, else /opt/homebrew/bin/claude.
CLAUDE_BIN=

# --- One-time Grimoire import (scripts/onehome/) and its tests ---
# The Grimoire graph directory to read old title pages from.
GRIMOIRE_GRAPH=
# Path to the grim CLI. Default: ~/.local/bin/grim.
GRIM_BIN=
